# Copy to .env.demo in the repository root. Used only by demo_fake_melee.

# Token of a separate "demo" Discord application — not the real bot's.
DISCORD_TOKEN=your_demo_bot_token_here

# The two demo servers, in the order of ROSTERS in demo_fake_melee/scenario.py.
GUILD_IDS=first_demo_server_id,second_demo_server_id

# A database of its own, so the real melee.db is never touched.
DB_PATH=demo.db

# Where `uv run python -m demo_fake_melee` is listening.
MELEE_BASE_URL=http://127.0.0.1:8765
