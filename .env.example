DISCORD_TOKEN=your_bot_token_here

# Servers this bot lives in, comma-separated. Commands are synced to each on every start (instant).
# Each server keeps its own roster, bindings and watches.
GUILD_IDS=your_server_id,another_server_id
# The older single-server GUILD_ID is still read when GUILD_IDS is unset. When upgrading a
# database from before multi-server support, its existing data is assigned to GUILD_ID
# (or, if that is unset, to the first entry of GUILD_IDS).

# Logging level: DEBUG shows every HTTP request/response, INFO is normal production level.
LOG_LEVEL=INFO
